<style>
@page {
  size: 21cm 29.7cm;
  margin: 1.9cm 2cm 1.9cm 2cm;
  mso-header-margin: 1cm;
  mso-footer-margin: 1cm;
  mso-paper-source: 0;
}
body {
  font-family: Calibri, "Segoe UI", Arial, sans-serif;
  font-size: 10.5pt;
  color: #000000;
  line-height: 1.25;
}
p { margin: 0 0 4pt 0; }

/* ---------- Header ---------- */
h1.name {
  font-family: Calibri, Arial, sans-serif;
  font-size: 22pt;
  font-weight: bold;
  letter-spacing: 0.6pt;
  text-align: center;
  margin: 0 0 2pt 0;
  padding: 0;
}
p.tagline {
  text-align: center;
  font-size: 11pt;
  color: #333333;
  margin: 0 0 12pt 0;
}

/* ---------- Section headings ---------- */
h2.sec {
  font-family: Calibri, Arial, sans-serif;
  font-size: 12pt;
  font-weight: bold;
  letter-spacing: 0.5pt;
  text-transform: uppercase;
  border-bottom: 1pt solid #000000;
  margin: 16pt 0 7pt 0;
  padding: 0 0 2pt 0;
  page-break-after: avoid;
}

/* ---------- Header info table (borderless) ---------- */
table.hdr { width: 100%; border-collapse: collapse; border: none; margin: 0 0 2pt 0; }
table.hdr td { border: none; padding: 0; vertical-align: top; }
table.info { border-collapse: collapse; border: none; }
table.info td { border: none; padding: 0 0 3pt 0; vertical-align: top; font-size: 10.5pt; }
td.lbl { width: 92pt; font-weight: bold; }

/* ---------- Lists ---------- */
ul { margin: 0 0 0 16pt; padding: 0; }
li { margin: 0 0 3pt 0; }
ul.tight li { margin: 0 0 2pt 0; }
ul.sub { margin: 2pt 0 0 16pt; }

/* ---------- Career summary blocks ---------- */
div.job { page-break-inside: avoid; margin: 0 0 9pt 0; }
p.jobline { margin: 0 0 2pt 0; }
span.jobrole { font-weight: bold; }
span.jobmeta { color: #333333; }

/* ---------- Project tables: ONE table per project ---------- */
table.proj {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
  page-break-inside: avoid;
  margin: 0;
}
table.proj td {
  border: 0.5pt solid #7F7F7F;
  padding: 3.5pt 5pt;
  vertical-align: top;
  font-size: 10.5pt;
}
table.proj td.k {
  width: 27%;
  background: #D9D9D9;
  font-weight: bold;
}
table.proj tr.top td {
  background: #BFBFBF;
  font-weight: bold;
  font-size: 11pt;
}
p.gap { margin: 0; padding: 0; font-size: 11pt; line-height: 1.1; }
</style>
</head>

